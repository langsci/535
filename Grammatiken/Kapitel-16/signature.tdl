;; -*-  coding:utf-8   -*-
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;   $RCSfile: types.tdl,v $
;;  $Revision: 1.2 $
;;      $Date: 2007/03/05 11:26:29 $
;;     Author: Stefan Mueller, Universität Bremen
;;    Purpose: 
;;   Language: TDL
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

intro_phon := bot & [
 PHON LIST ].


sign := intro_phon & [
 synsem synsem,
 v2     bool,
 rels  list,
 hcons list ].

list := bot.
e_list := list.
ne_list := list & [
  hd bot,
  tl list ].

none_or_synsem := bot.
none   := none_or_synsem & none_or_local.

synsem := none_or_synsem & [
 loc  local,
 nonloc nonloc,
 trace minus_or_extraction_or_vm,
 lex    bool,
 phrase bool,
 max_   bool].


none_or_local := bot.
local := none_or_local & [
  cat  cat,
  cont hook ].

cat := bot & [
  head   head,
  spr    list,
  comps  list,
  arg_st list ].

hook := bot & [
  ltop handle,
  ind  event_or_index ].

intro_complex_sign := sign &
 [ dtrs list ].

; testing 
intro_complex_sign_dtr := sign &
 [ dtr sign ].

; Zeichen, die in Syntaxregeln als Töchter vorkommen können,
; d.h. Phrasen und flektierte bzw. vollständige Wörter, aber keine
; unflektierten Stämme.
syntactic_sign := sign.
lexical_sign   := sign &
  [ inf_marking bool ].

phrase := intro_complex_sign.

headed_phrase := phrase & [
  head_dtr sign ].

; all phrases that have non-head-dtrs. The elements in head-dtr and non-head-dtr are not
; (necessarily) ordered in surface order. Only dtrs are. So head-dtr and non-head-dtrs can be used
; as pointers to daughters. In principle, there could be phrases without a head-dtr that have
; unordered dtrs. But the only unheaded-phrases in the current grammar are relative clauses (rc),
; verbinitial lexical rule-like unary projections and coordination rules.
headed_flexible_order_phrase := headed_phrase & [
 non_head_dtrs list ].

; V2 and relative clauses
filler_phrase := phrase.

head_non_adjunct_phrase    := headed_phrase.
head_non_complement_phrase := headed_phrase.
head_non_filler_phrase     := headed_phrase.
head_non_specifier_phrase  := headed_phrase.
head_non_cluster_phrase    := headed_phrase.

head_non_complement_non_cluster_phrase := head_non_cluster_phrase & head_non_complement_phrase.

head_adjunct_phrase    := headed_flexible_order_phrase & head_non_complement_non_cluster_phrase & head_non_filler_phrase     & head_non_specifier_phrase.
head_cluster_phrase    := headed_flexible_order_phrase & head_non_specifier_phrase  & head_non_filler_phrase     & head_non_adjunct_phrase.
head_complement_phrase := headed_flexible_order_phrase & head_non_adjunct_phrase    & head_non_filler_phrase     & head_non_specifier_phrase.
head_filler_phrase     := headed_flexible_order_phrase & head_non_adjunct_phrase    & head_non_complement_non_cluster_phrase & head_non_specifier_phrase & filler_phrase.
head_specifier_phrase  := headed_flexible_order_phrase & head_non_adjunct_phrase    & head_non_filler_phrase     & head_non_complement_non_cluster_phrase.


coord_phrase := phrase.

verb_movement_rule := optionally_coherent_le & complex_word_dtrs.
verb_initial_rule  := verb_movement_rule & complementizer_like_sign.
mvf_rule           := verb_movement_rule.

; DTRS enthält den zu flektierenden Stamm und INFL
; die Information über das Affix.
infl_lr := complex_word & [
  affix affix ].

non_relational_lr :< intro_complex_sign_dtr.

; Teilt auch morphophonologische Merkmale.
n_v_infl_lr := infl_lr.

prd_adj_infl_lr  :< infl_lr.

attr_adj_infl_lr := infl_lr & non_relational_lr.

;isect_attr_adj_infl_lr  := attr_adj_infl_lr & isect_n_modifier.
;scopal_attr_adj_infl_lr :< attr_adj_infl_lr.

part_derivation_lr     :< derived_stem.
ppp_part_derivation_lr :< part_derivation_lr.
inf_part_derivation_lr :< part_derivation_lr.


fin_verb_infl_lr := complex_word.

reg_fin_verb_infl_lr   := fin_verb_infl_lr & n_v_infl_lr.
irreg_fin_verb_infl_lr := fin_verb_infl_lr & n_v_infl_lr & irreg_infl_lr.

irreg_infl_lr := infl_lr.

irreg_bse_or_inf_verb_infl_lr := bse_or_inf_verb_infl_lr & irreg_infl_lr.

bse_or_inf_verb_infl_lr := complex_word & non_relational_lr.

bse_verb_infl_lr := bse_or_inf_verb_infl_lr.
inf_verb_infl_lr := bse_or_inf_verb_infl_lr.

reg_bse_or_inf_verb_infl_lr := bse_or_inf_verb_infl_lr & n_v_infl_lr.

reg_bse_verb_infl_lr := reg_bse_or_inf_verb_infl_lr & bse_verb_infl_lr.
reg_inf_verb_infl_lr := reg_bse_or_inf_verb_infl_lr & inf_verb_infl_lr.

ppp_verb_infl_lr     := non_cannonical_complex_word & non_relational_lr.
reg_ppp_verb_infl_lr := ppp_verb_infl_lr & n_v_infl_lr.


; Wörter, die im Lexikon aufgelistet sind.

word :=
  syntactic_sign &
  lexical_sign.

simple_word := word.

stem := overt_le & 
 [ infl infl ].

intro_morphophon := bot & [
  morphophon morphophon ].

derived_stem   := stem & intro_complex_sign_dtr.
underived_stem := stem.



rc := filler_phrase & isect_n_modifier.


; empty HCONS
; could be done here, but then hcons would not be displayed in GRALE
; non_scopal_le := lexical_sign & 
;   hcons e_list].
non_scopal_le := lexical_sign.

; empty RELS
non_relational_le := lexical_sign.

non_scopal_non_relational_le := non_scopal_le & non_relational_le.

; lexical elements which do not contribute anything but share
; LTOP and IND with their only element in their ARG-ST.
; complement prepositions and some complementizers.
transparent_head_le := lexical_sign.

transparent_non_scopal_non_relational_le := transparent_head_le & non_scopal_non_relational_le.

arg0_le := lexical_sign.

ltop_lbl_le := lexical_sign.

arg0_ltop_lbl_le := arg0_le & ltop_lbl_le.


; Wörter, die mit Lexikonregeln abgeleitet wurden
; Alle Lexikonregeln sind Untertypen von complex_word
complex_word :=
  intro_complex_sign_dtr &
  word.

complex_word_dtrs :=
  intro_complex_sign &
  word.

; Das ist kein Untertyp von word und somit wird das Argumentrealisierungsprinzip nicht angewendet.
non_cannonical_complex_word :< intro_complex_sign_dtr.


empty_rel_le := sign.
empty_rel_word := empty_rel_le & word.

empty_slash_le := sign.
empty_slash_word := empty_slash_le & word.

; alle sichtbaren Lexikonelemente außer Lexikonregeln
overt_le := lexical_sign.

;overt_word := overt_le & word.

non_overt_le := empty_rel_le.

; Wenn Spuren vom Typ word sind, wird das Argumentstrukturprinzip angewendet. Das ist aber
; ungünstig. Denn die Füller können vom Typ word oder phrase sein. Das muss also alles dort
; entscheiden werden. Spuren sollten also weder noch sein. Einfach lexical_sign.
; Problem: head_cluster_phrase möchte eine Kopftochter vom Typ word. Die Verbspur kann dort auch Kopftochter sein.
trace      := non_overt_le & empty_rel_le & non_scopal_non_relational_le.

; leere Determinatoren und Nomina
empty      := non_overt_le & empty_slash_word.

e_trace :< trace.
v_trace := trace & empty_slash_le & spr_saturated_le.

spr_saturated_le := sign.

spr_saturated_word := spr_saturated_le & word.

; inheritance superflous since the empty specifier follows from an empty ARG-ST list.
saturated_word   := spr_saturated_word.

; is this needed?
relational_le  := ltop_lbl_le.

relational_arg0_le := relational_le & arg0_ltop_lbl_le.

determiner_word := saturated_word.

determiner := determiner_word & empty_rel_word.
possessive := determiner_word & overt_le.

overt_determiner := determiner & overt_le.
empty_determiner := determiner & empty.

simple_possessive      := possessive & empty_rel_word.
possessive_rel_pronoun := possessive & rel_pronoun.

noun_word := overt_le.

pronoun := saturated_word & overt_le.

; damit is also a pronoun, but not a nominal pronoun
nominal_pronoun := noun_word & pronoun.

proper_noun  := saturated_word & noun_word & empty_rel_word.

rel_pronoun :< pronoun.


nominal_non_rel_pronoun := nominal_pronoun & empty_rel_word & non_scopal_non_relational_le.

expl_pronoun :< nominal_non_rel_pronoun.
pers_pronoun :< nominal_non_rel_pronoun.


; all rel_pronouns apart from possessives
; womit, worüber, der, die, das
non_relational_rel_pronoun := rel_pronoun & non_scopal_non_relational_le.

nominal_rel_pronoun  := nominal_pronoun & non_relational_rel_pronoun.

; noun with a determiner
det_noun_word := noun_word & non_scopal_le & relational_arg0_le & empty_rel_word.

; noun with a determiner and nothing else.
simple_noun  := det_noun_word.

; noun with a determiner and a genitive NP.
relational_noun := det_noun_word.

;; Stems

adj_stem         := spr_saturated_le & empty_rel_le & underived_stem.

; klug
isect_adj        := adj_stem & non_scopal_le & relational_arg0_le.

; mutmaßlich
scopal_adj       := adj_stem & scopal_modifier_le.

; klug
np_adj    :< isect_adj.

; treu
np_np_adj :< isect_adj.

; stolz
np_pp_adj :< isect_adj.



verb_stem    := spr_saturated_le & underived_stem & 
                relational_arg0_le & empty_rel_le.

aux_verb := coherent_le & verb_stem.

perfect_aux_verb := ppp_inf_verb_le & aux_verb & subj_raising_verb.  ; subject_raising stimmt für sein_perfect nicht
haben_perfect    :< perfect_aux_verb.
sein_perfect     := non_flip_verb_stem & perfect_aux_verb.

passive_aux_verb := aux_verb & raising_verb.

;; Alle Passivhilfsverben außre lassen
simple_passive_aux_verb := passive_aux_verb & non_flip_verb_stem.

ppp_passive_aux_verb := ppp_inf_verb_le & passive_aux_verb.

simple_ppp_passive_aux_verb := simple_passive_aux_verb & ppp_passive_aux_verb.

agentive_passive_aux_verb :< simple_ppp_passive_aux_verb.
stative_passive_aux_verb  :< simple_ppp_passive_aux_verb.


modal_zu_inf := zu_inf_verb_le & raising_verb.

modal_sein  := simple_passive_aux_verb  & modal_zu_inf. 
modal_haben := subj_raising_verb & coherent_le & modal_zu_inf. 


optionally_coherent_le := spr_saturated_le.

raising_verb := optionally_coherent_le & verb_stem.

dative_passive_aux_verb   := ppp_passive_aux_verb & non_flip_verb_stem.

modal_verb := bse_inf_verb_le & subj_raising_verb.

bse_inf_verb_le := raising_verb & coherent_le.

ppp_inf_verb_le := raising_verb & coherent_le.

subj_raising_verb := raising_verb.

aci_verb := bse_inf_verb_le.

lassen_passive := bse_inf_verb_le & passive_aux_verb.

copula_verb := coherent_le & subj_raising_verb & non_flip_verb_stem.


futur_aux_verb := aux_verb & bse_inf_verb_le & subj_raising_verb.

non_flip_coherent_zu_inf_subj_raising_verb := coherent_le & subj_raising_verb & zu_inf_verb_le.

phase_verb := subj_raising_verb & zu_inf_verb_le.

control_verb := non_flip_verb_stem & non_scopal_verb_stem & optionally_coherent_le.

zu_inf_verb_le := non_flip_verb_stem.

subj_control_verb := control_verb.

obj_control_verb := control_verb & zu_inf_verb_le.

np_np_v_subj_zu_inf_control_verb := subj_control_verb & zu_inf_verb_le.

np_v_subj_zu_inf_control_verb := subj_control_verb & zu_inf_verb_le.

np_np_v_obj_zu_inf_control_verb := obj_control_verb.

coherent_le := optionally_coherent_le.

non_flip_raising_verb := non_flip_verb_stem & raising_verb.

non_flip_verb_stem := verb_stem.

subjlos_verb := non_flip_verb_stem & non_scopal_verb_stem.
expl_np_verb := non_flip_verb_stem & non_scopal_verb_stem & nerg_verb.

non_scopal_verb_stem := verb_stem & non_scopal_le.

intrans_verb := non_flip_verb_stem.

non_scopal_intrans_verb := intrans_verb & non_scopal_verb_stem.

strict_intrans_verb := non_scopal_intrans_verb.

nerg_verb          :< verb_stem.

intrans_nerg_verb  := intrans_verb & nerg_verb.
intrans_unacc_verb :< intrans_verb.

strict_intrans_nerg_verb  := strict_intrans_verb & intrans_nerg_verb.
strict_intrans_unacc_verb := strict_intrans_verb & intrans_unacc_verb.

np_np_verb      := non_scopal_intrans_verb & bi_or_more_val_verb.
np_pp_verb      := non_scopal_intrans_verb & bi_or_more_val_verb.

np_np_dat_verb :< np_np_verb.

np_np_dat_nerg_verb := np_np_dat_verb & intrans_nerg_verb.

np_np_unacc_verb    := np_np_verb & intrans_unacc_verb.

; helfen, kennen, geben
bi_or_more_val_verb := non_scopal_verb_stem.

; kennen, geben
trans_verb := bi_or_more_val_verb.

strict_trans_verb := trans_verb.
ditrans_verb      := trans_verb.

glauben_denken_verb := intrans_nerg_verb.

preposition_word := overt_le & non_scopal_le & empty_rel_word.
comp_preposition := preposition_word & transparent_non_scopal_non_relational_le.
mod_preposition  := preposition_word & relational_le.

noun_mod_preposition := mod_preposition & isect_n_modifier_le.
verb_mod_preposition := mod_preposition & isect_v_modifier_le.

location_noun_mod_prep := noun_mod_preposition.
location_verb_mod_prep := verb_mod_preposition.


n_modifier_word := n_modifier & relational_le & overt_le & empty_rel_word.


; old isect_n_modifier_word := isect_n_modifier_le & n_modifier_word.

; old intersective_adj := isect_n_modifier_word.

; old attr_adjective_word := n_modifier_word.



; Adjektive, Präpositionen, Nomina, aber auch Relativsätze (=phrasal)
n_modifier := sign.

isect_modifier := sign.

isect_n_modifier := n_modifier & isect_modifier.

isect_modifier_le := isect_modifier & non_scopal_le.

isect_n_modifier_le := isect_modifier_le & n_modifier.
isect_v_modifier_le := isect_modifier_le & v_modifier.

; Adverbien, Präpositionen
v_modifier := sign.

v_modifier_word := v_modifier & relational_le & overt_le & empty_rel_word.


scopal_modifier_le := ltop_lbl_le.

scopal_v_modifier_le := scopal_modifier_le & v_modifier_word.

adv_word := saturated_word & v_modifier_word.
scopal_adv_word := scopal_v_modifier_le & adv_word.

isect_adv_word := isect_v_modifier_le & adv_word.

complementizer_like_sign := spr_saturated_le & empty_rel_le.

complementizer_word := complementizer_like_sign & transparent_non_scopal_non_relational_le & overt_le & simple_word.

conj_word := relational_arg0_le & empty_rel_word & overt_le.

head := bot & [
   mod     none_or_synsem,
   spec    none_or_synsem,
   subj    list,
   scopal  bool,
   initial bool,
   dsl     none_or_local,
   prd     bool ].

non_modifier_head := head & [
  mod none ].

non_subj_head := head & [ subj e_list ].

non_spec_head := head & [
  spec none ].

non_dsl_head := head & [
  dsl none ].

modifier_head := non_spec_head & non_dsl_head & 
 [ mod          synsem,
   pre_modifier bool ].

pre_modifier_head := modifier_head & [
  pre_modifier plus ].

post_modifier_head := modifier_head & [
  pre_modifier minus ].


; prep steht für Prä- und Postpositionen, der initial-Wert wird in le_macros.pl festgelegt
prep := non_spec_head & non_dsl_head & non_subj_head.

comp_prep := prep & intro_case_head & non_modifier_head &
 [ pform pform ].

; kann nach Nomina und vor Verben stehen, siehe le_macros.pl
mod_prep := prep & modifier_head & non_subj_head.

intro_case_head := head &
 [ case cas ]. 

intro_morph_case := bot & [
  morph_case case ].

cas := intro_morph_case & [
  case_type case_type ].


det := intro_case_head & intro_gen & intro_num & non_modifier_head & non_dsl_head & non_subj_head & intro_dtype.
       
noun := intro_case_head & non_modifier_head & non_spec_head & non_dsl_head & non_subj_head.

adj_or_participle_or_verb := non_spec_head &
 [ da list ].

participle_or_verb :< adj_or_participle_or_verb.

verb := participle_or_verb & non_modifier_head & intro_flip & [
   vform vform,
   auxf  auxf,
   prd   minus ].

adj_or_participle := non_dsl_head & adj_or_participle_or_verb & [
  initial minus ].


adj_participle := adj_or_participle & participle_or_verb.

attr_adj_or_attr_participle := adj_or_participle & 
 intro_case_head & 
 pre_modifier_head.

attr_participle := adj_participle & attr_adj_or_attr_participle.

adj :< adj_or_participle.

attr_adj := adj & attr_adj_or_attr_participle.

prd_adj  := adj & intro_flip & non_modifier_head & [
  prd plus ].

; Die Verbalkomplexschemata nehmen auf FLIP Bezug. Da Adjektive im Prädikatskomplex
; vorkommen können, müssen sie ein FLIP-Merkmal haben.
intro_flip := head &
 [ flip bool ].


comp := non_spec_head & non_modifier_head & non_dsl_head & non_subj_head & [
  cform cform ].

coord := non_dsl_head & non_modifier_head & non_subj_head & [
  initial plus ].

relativizer := post_modifier_head & non_subj_head.

; adverbs may be pre- or post-modifiers
adv := modifier_head & non_subj_head.

cform := bot.

dass := cform.

string := bot.

pform := bot.

an_pform  := pform.
auf_pform := pform.
für_pform := pform.
von_pform := pform.
zu_pform  := pform.


vform   := bot.
fin     := vform.
non_fin := vform.

; irreguläre Form von `sein'
bse_or_inf := non_fin.
bse := bse_or_inf & bse_or_ppp.
inf := bse_or_inf.
       
bse_or_ppp := non_fin.
ppp := bse_or_ppp.

auxf  :< bot.

haben :< auxf.
sein  :< auxf.

affix  := intro_phon & intro_fk.

intro_fk := bot &
 [ fk fk ].


; Die Unterscheidung zwischen Präfixen und Suffixen muß hier gemacht
; werden. Man kann sie nicht über INITIAL+/- machen, da das ein syntaktisches
; Merkmal ist. Suffixe von Nomina wären INITIAL-, aber Nomina sind INITIAL+.
; Für die Anordnung von Morphemen müssen deshalb andere Linearisierungsbeschränkungen
; gelten als für die Anordnung von Wörtern. 14.06.2006
prefix := affix.
suffix := affix.

attr_adj_i_suffix := suffix &
  intro_num &
  intro_gen &
  intro_morph_case &
  intro_dtype.


; fk:fk_v auskommentiert, da das residues erzeugt ...
verb_i_suffix := suffix & intro_morphophon.

morphophon := bot.

v_morphophon := morphophon &  
 [ ep   bool,
   epp  bool,
   evp  bool,
   sm   bool,
   pl_n bool,
   spe  bool, 
   tm   bool_or_t,
   em   bool       ].


fin_verb_i_suffix := verb_i_suffix & intro_per & intro_num &
 [ temo temo ].

ppp_verb_i_suffix := verb_i_suffix.

argument := bot & [
  arg      synsem,
  realized bool,
  raised   bool ].


relation := bot & [
  lbl handle ].

arg0_relation := relation & [
  arg0 event_or_index ].


affe_rel         := arg0_relation.
aufsatz_rel      := arg0_relation.
ball_rel         := arg0_relation.
beamter_rel      := arg0_relation.
beispiel_rel     := arg0_relation.
buch_rel         := arg0_relation.
einhorn_rel      := arg0_relation.
fahrrad_rel      := arg0_relation.
film_rel         := arg0_relation.
frau_rel         := arg0_relation.
kind_rel         := arg0_relation.
kran_rel         := arg0_relation.
lied_rel         := arg0_relation.
lügner_rel       := arg0_relation.
mann_rel         := arg0_relation.
mädchen_rel      := arg0_relation.
märchen_rel      := arg0_relation.
mitarbeiter_rel  := arg0_relation.
mörder_rel       := arg0_relation.
roman_rel        := arg0_relation.
speisekammer_rel := arg0_relation.
stock_rel        := arg0_relation.
eis_rel         := arg0_relation.
überraschung_rel := arg0_relation.
wagen_rel        := arg0_relation.
wurst_rel        := arg0_relation.

pronoun_rel      := arg0_relation.

named_rel := arg0_relation & [
  name string ].

regnen_rel := arg0_relation.

morgen_rel := arg1_relation.
oft_rel    := arg1_relation.

quant_rel := arg0_relation & [
  rstr handle,
  body handle ].

udef_q    := quant_rel.
def_q     := quant_rel.
every_q   := quant_rel.
exists_q  := quant_rel.
pronoun_q := quant_rel.
proper_q  := quant_rel.

arg1_relation := relation & [
  arg1 event_or_index ].

arg2_relation := relation & [
  arg2 event_or_index ].

arg3_relation := relation & [
  arg3 event_or_index ].


arg01_relation := arg0_relation & arg1_relation.

arg02_relation := arg0_relation & arg2_relation.

arg03_relation := arg0_relation & arg3_relation.

arg012_relation := arg01_relation & arg02_relation.

arg013_relation := arg01_relation & arg03_relation.

arg0123_relation := arg012_relation & arg013_relation.

; decided to just number arguments in order of appearance.
; maybe we have generalizations over roles, not sure yet.
; 03.10.2026
; arg023_relation := arg02_relation & arg03_relation.

arg12_relation := arg1_relation & arg2_relation.


lassen_rel := arg013_relation.
sehen_rel  := arg013_relation.

versuchen_rel := arg013_relation.

beginnen_rel := arg03_relation.

; Kopula
support_rel :< arg03_relation.

scheinen_rel := arg03_relation.

groß_rel        := arg01_relation.
interessant_rel := arg01_relation.
klein_rel       := arg01_relation.
klug_rel        := arg01_relation.
schön_rel       := arg01_relation.
schwierig_rel   := arg01_relation.

treu_rel      :< arg012_relation.
stolz_auf_rel :< arg012_relation.

angeblich_rel      := arg1_relation.
mutmaßlich_rel     := arg1_relation.
nicht_rel          := arg1_relation.
wahrscheinlich_rel := arg1_relation.


arbeiten_rel := arg01_relation.
bellen_rel   := arg01_relation.
lachen_rel   := arg01_relation.
schlafen_rel := arg01_relation.
schmelzen_rel := arg02_relation.
spielen_rel  := arg01_relation.
tanzen_rel   := arg01_relation.

helfen_rel        := arg012_relation.
jagen_rel         := arg012_relation.
kennen_rel        := arg012_relation.
lesen_rel         := arg012_relation.
lieben_rel        := arg012_relation.
nehmen_rel        := arg012_relation.
reparieren_rel    :< arg012_relation.
schlagen_rel      :< arg012_relation.
singen_rel        := arg012_relation.
widersprechen_rel :< arg012_relation.


denken_an_rel := arg012_relation.
glauben_rel   := arg012_relation.


in_rel        := arg12_relation.

erlauben_rel    := arg0123_relation.
erzählen_rel    := arg0123_relation.

geben_rel       :=  arg0123_relation.
schenken_rel    :=  arg0123_relation.

versprechen_rel := arg0123_relation.
zwingen_rel     := arg0123_relation.


grauen_rel  := arg02_relation.
sterben_rel := arg02_relation.

poss_rel := arg012_relation.

bild_rel := arg02_relation.

tochter_rel := arg02_relation.

sohn_rel    := arg02_relation.

besitzen_rel  :< arg012_relation.
gelingen_rel  :< arg012_relation.

conjunction_rel := arg0_relation & [
  lindex event_or_index,
  rindex event_or_index].

conjunction_n_rel := conjunction_rel & [
  arg0 index ].

conjunction_v_rel := conjunction_rel & [
  arg0 event,
  lhandle handle,
  rhandle handle].

und_rel := conjunction_rel.

und_n_rel := conjunction_n_rel & und_rel.
und_v_rel := conjunction_v_rel & und_rel.

modal_rel := arg03_relation.

dürfen_rel := modal_rel.
können_rel := modal_rel.
müssen_rel := modal_rel.
sollen_rel := modal_rel.
wollen_rel := modal_rel.

futur_rel   := arg03_relation.
perfect_rel := arg03_relation.

; what is this????
passive_rel :< arg03_relation.

agentive_passive_rel :< arg03_relation.
stative_passive_rel  :< arg03_relation.



event_or_index := bot.

event := event_or_index & [
  mode mode ].


; Für Satztypen
mode := bot.

assertion_or_imperative_or_interrogative := mode.
assertion_or_imperative     := assertion_or_imperative_or_interrogative.
assertion_or_interrogative  := assertion_or_imperative_or_interrogative.      ; Flexion = ind_conj -> assertion_or_interrogative
imperative_or_interrogative := assertion_or_imperative_or_interrogative.

interrogative := assertion_or_interrogative  & imperative_or_interrogative.
imperative    := imperative_or_interrogative & assertion_or_imperative.

assertion  := assertion_or_imperative & assertion_or_interrogative.


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 			TENSE-MOOD- combinations		;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; this is a trick sort that can be used to push things down
;; to one of the sorts that inherit from it.


; tense and mood are collapsed
temo := arg03_relation.

;    tense
pres := temo.
pres_ind_conj := pres & ind_conj.
pres_ind_imp  := pres & ind_imp.
pres_conj_imp := pres & conj_imp.

pres_ind  := pres_ind_conj & pres_ind_imp  & pres_ind_or_past_conj.
pres_conj := pres_ind_conj & pres_conj_imp & conj.

; = imp
pres_imp  := pres_conj_imp & pres_ind_imp & imp_or_past_conj.

; = past_ind or past_conj
past_ind_conj := ind_or_past_conj.

past_ind  := past_ind_conj.
past_conj := past_ind_conj & pres_ind_or_past_conj & conj & imp_or_past_conj.



; mood
ind_conj := temo.

               ind_or_past_conj := ind_conj & ind_imp_or_past_conj.
                 ind := ind_or_past_conj & ind_imp.



                 pres_ind_or_past_conj := ind_or_past_conj.
               conj := ind_conj & conj_imp.
             ind_imp_or_past_conj := temo.
             ind_imp := ind_imp_or_past_conj.


;       %         imp 
;       %           &pres_imp     % single branch redundant


               imp_or_past_conj := ind_imp_or_past_conj.

conj_imp := temo.

intro_per := bot & [
  per per ].


index := event_or_index & intro_num & intro_per.
ref := index & intro_gen.
expl := index & [
  per third,
  num sg ].

handle := event_or_index.

qeq := bot & [
  harg handle,
  larg handle ].

nonloc := bot & [
  rel   list,
  slash list ].

case_type := bot.
str := case_type.
lex := case_type.

case := bot.

nom_or_dat_or_acc := case.

; Plural
nom_or_gen_or_acc := case.

; Endung `n' in Singular Junggesellen
gen_or_dat_or_acc := case.

nom_or_acc := nom_or_gen_or_acc & nom_or_dat_or_acc.
dat_or_acc := gen_or_dat_or_acc & nom_or_dat_or_acc.
gen_or_dat := gen_or_dat_or_acc.

nom := nom_or_acc.
gen := gen_or_dat & nom_or_gen_or_acc.
dat := gen_or_dat & dat_or_acc.
acc := nom_or_acc & dat_or_acc.


genus := bot.

; Beamte
fem_or_mas := genus.

; Index von Mädchen, Weib, ...
fem_or_neu := genus.

; ein
mas_or_neu := genus.
       
fem := fem_or_mas & fem_or_neu.
mas := fem_or_mas & mas_or_neu.
neu := fem_or_neu & mas_or_neu.

per := bot.

first_or_third := per.

; Stamm 2:  ich fange vs. du fängst, er fängt
second_or_third := per.

first  := first_or_third.
second := second_or_third.
third  := first_or_third & second_or_third.


num := bot.
sg  := num.
pl  := num.

intro_dtype := bot & [
  dtype dtype ].

dtype  := bot.
weak   := dtype.
strong := dtype.


intro_num := bot & [
  num num ].

intro_gen := bot & [
  gen genus ].

fk := bot.

fk_n := fk.

fk_v := fk.

nfk_1 := fk_n.
nfk_2 := fk_n.
nfk_3 := fk_n.
nfk_4 := fk_n.
nfk_e := fk_n.

nfk_e1 := nfk_e.
nfk_e2 := nfk_e.
nfk_e3 := nfk_e.

nfk_er := fk_n.
nfk_es := fk_n.
nfk_n1 := fk_n.
nfk_n2 := fk_n.
nfk_n3 := fk_n.
nfk_n4 := fk_n.
nfk_n5 := fk_n.
nfk_s  := fk_n.

nfk_s1 := nfk_s.
nfk_s2 := nfk_s.

nfk_p   := fk_n.
nfk_i1  := fk_n.
nfk_ten := fk_n.

non_strong := fk_v.
non_weak   := fk_v.
mixed_or_modal := non_strong & non_weak.

v_weak   := non_strong.
mixed    := mixed_or_modal.
modal    := mixed_or_modal.
v_strong := non_weak.



; affix_ ist ein technisches Merkmal, das gebraucht wird, weil
; für relationale Beschränkungen in LRs nur der Input berücksichtigt wird.
infl := bot & [
  affix_ affix ].

noun_infl := infl & intro_fk & [
  umlaut string,
  k_umw  bool ].

; Alle flexionsrelevante Information:
; FK ist die FLexionsklasse.
; MORPHOPHON wird mit den Merkmalen des Affixes geteilt.
; V_STEMS enthält weiter Stämme bei starken Verben
; BET1 enthält Information über die Betonung der ersten Silbe.
; Das ist für die Partizipbildung relevant. ge-redet vs. *ge-interessiert.
verb_infl := infl & intro_fk & intro_morphophon & [
  v_stems v_stems,
  bet1    bool ].

v_stems := bot & [
  pres2  string,
  past   string,
  part   string,
  conj   string,
  imp_st string ].


bool_or_t := bot.
bool := bool_or_t.
t    := bool_or_t.

plus   := bool.

minus_or_extraction_or_vm := bot.

extraction_or_minus := minus_or_extraction_or_vm.
extraction_or_vm    := minus_or_extraction_or_vm.
minus_or_vm         := minus_or_extraction_or_vm.

extraction := extraction_or_minus & extraction_or_vm.
minus      := extraction_or_minus & minus_or_vm          & bool.
vm         := extraction_or_vm    & minus_or_vm.
